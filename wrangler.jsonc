/**
 * Wrangler config — Cloudflare Workers (via @opennextjs/cloudflare, ADR-011).
 *
 * NOTA IMPORTANTE: este projeto roda em Cloudflare WORKERS, não Pages.
 * @cloudflare/next-on-pages (Pages adapter) é incompatível com Next.js 16
 * (peer dep next <=15.5.2). Cloudflare migrou suporte oficial Next.js para
 * Workers via OpenNext. Detalhes em docs/devops/cloudflare-pages-setup.md.
 *
 * Comandos:
 *   - Build:    npx opennextjs-cloudflare build
 *   - Preview:  npx wrangler dev
 *   - Deploy:   npx opennextjs-cloudflare deploy
 *
 * Bindings:
 *   - ASSETS                     → estáticos servidos do .open-next/assets
 *   - WORKER_SELF_REFERENCE      → self-binding para ISR/cache invalidation
 *   - IMAGES                     → Cloudflare Images binding (opt-in futuro)
 *
 * NOTA (go-live MVP): incremental cache via R2 foi REMOVIDO para destravar o
 * primeiro deploy sem depender de R2 ativo na conta (site é majoritariamente
 * SSG). Para reativar ISR com cache persistente, recriar o binding
 * `NEXT_INC_CACHE_R2_BUCKET` aqui + `r2IncrementalCache` em open-next.config.ts
 * e rodar `wrangler r2 bucket create planoamilempresas-opennext-cache`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "planoamilempresas",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "planoamilempresas"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "production": {
      "name": "planoamilempresas",
      "vars": {
        "NEXT_PUBLIC_SITE_URL": "https://planoamilempresas.com.br"
      },
      "routes": [
        { "pattern": "planoamilempresas.com.br", "custom_domain": true },
        { "pattern": "www.planoamilempresas.com.br", "custom_domain": true }
      ]
    },
    "preview": {
      "name": "planoamilempresas-preview",
      // Habilita Version Preview URLs (<hash>-planoamilempresas-preview.<subdominio>.workers.dev)
      // para o CI de qualidade (preview-quality.yml) rodar axe/lhci/schema contra um
      // preview real. Default de preview_urls passou a seguir workers_dev (wrangler >=4.44),
      // então declaramos ambos explicitamente. Produção segue em custom domain, sem workers.dev.
      "workers_dev": true,
      "preview_urls": true,
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "planoamilempresas-preview"
        }
      ]
    }
  }
}
